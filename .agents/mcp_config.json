{
  "mcpServers": {
    "gsd": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "@opengsd/gsd-core",
        "gsd-mcp-server"
      ]
    },
    "StitchMCP": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://stitch.googleapis.com/mcp",
        "--header",
        "X-Goog-Api-Key: YOUR_GCP_API_KEY"
      ]
    },
    "21st": {
      "url": "https://21st.dev/api/mcp",
      "serverUrl": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "YOUR_21ST_API_KEY"
      }
    }
  }
}
